/* Vesna 常驻桥 —— 由模组以子进程方式启动（events.json 的 "resident": true）
   协议：stdin 每行一个 JSON 请求 {"id": N; "event": "..."; "payload": {...}}
         stdout 每行一个 JSON 响应 {"id": N; "result": {...}}
   事件函数 _on_<event>(payload) 返回结果 dict/actions，主循环负责分发 */
state = {},

def _on_server_started(payload)-
-/* 服务器启动事件（由桥接模组调用） */
-back({"message": "Hello from Vesna!"}),
def _on_server_stopped(payload)-
-/* 服务器停止事件 */
-back({"actions": [{"type": "log"; "text": "server stopped"}]}),
def _on_player_join(payload)-
-/* 玩家加入事件：argv[1] 是 JSON payload（player / uuid） */
-name = payload["player"],
-back({"message": "欢迎 " + name + " 加入服务器！"}),
def _on_player_leave(payload)-
-/* 玩家离开事件：argv[1] = JSON payload（player / uuid / op） */
-name = payload["player"],
-back({"actions": [{"type": "log"; "text": name + " left the server"}]}),
def _on_player_death(payload)-
-/* 玩家死亡事件：payload 含 player / message */
-name = payload["player"],
-msg = payload["message"],
-back({"actions": [{"type": "message"; "target": "all"; "text": "注意：" + name + " 倒下了！"}]}),
def _on_player_kill(payload)-
-/* 玩家击杀事件：payload 含 player / victim */
-name = payload["player"],
-victim = payload["victim"],
-back({"actions": [{"type": "message"; "target": "all"; "text": name + " 击败了 " + victim + "！"}]}),
def _on_block_break(payload)-
-/* 破坏方块事件：payload 含 player / block / x / y / z */
-name = payload["player"],
-blk = payload["block"],
-back({"actions": [{"type": "log"; "text": name + " 破坏了 " + blk}]}),
def _on_block_place(payload)-
-/* 放置方块事件 */
-name = payload["player"],
-blk = payload["block"],
-back({"actions": [{"type": "log"; "text": name + " 放置了 " + blk}]}),
def _on_player_chat(payload)-
-/* 聊天事件：关键词自动回复（payload 含 player / message / op） */
-name = payload["player"],
-msg = payload["message"],
-reply = "",
-if #contains(msg; "hello") or #contains(msg; "Hello") or #contains(msg; "你好")-
--reply = "Hello, " + name + "！我是 Vesna 机器人。",
--,
-if reply != ""-
--back({"actions": [{"type": "message"; "target": "player:" + name; "text": reply}]}),
--,
def _on_player_advancement(payload)-
-/* 进度达成事件：payload 含 player / advancement */
-name = payload["player"],
-adv = payload["advancement"],
-back({"actions": [{"type": "message"; "target": "all"; "text": name + " 达成进度：" + adv}]}),
def _on_server_tick(payload)-
-/* 服务器 tick（每秒一次）：payload 含 tick（秒数）。示例：每 300 秒记一次日志 */
-t = payload["tick"],
-if t - #floor(t / '300') * '300' == '0'-
--back({"actions": [{"type": "log"; "text": "server running " + #str(t) + "s"}]}),
--,
def _on_timer_example(payload)-
-/* 定时任务示例：events.json 的 timers 里每 30 秒触发一次 */
-back({"message": "这是来自 Vesna 的定时广播（每 30 秒）"}),
def _on_player_use_block(payload)-
-/* 使用/交互方块事件：payload 含 player / block / x / y / z / hand */
-player = payload["player"],
-block = payload["block"],
-back({"actions": [{"type": "log"; "text": player + " 交互了 " + block}]}),
def _on_player_use_item(payload)-
-/* 使用物品事件：payload 含 player / item / hand */
-player = payload["player"],
-item = payload["item"],
-back({"actions": [{"type": "log"; "text": player + " 使用了 " + item}]}),
def _on_player_respawn(payload)-
-/* 玩家重生事件：payload 含 player / uuid / op */
-player = payload["player"],
-back({"actions": [{"type": "message"; "target": "all"; "text": player + " 重生了！"}]}),
def _on_entity_damage(payload)-
-/* 实体受伤事件：payload 含 entity / attacker / amount */
-entity = payload["entity"],
-attacker = payload["attacker"],
-amount = payload["amount"],
-back({"actions": [{"type": "log"; "text": entity + " 受到 " + #str(amount) + " 伤害（来源 " + attacker + "）"}]}),
def _on_player_drop_item(payload)-
-/* 玩家丢弃物品事件：payload 含 player / item / count */
-player = payload["player"],
-item = payload["item"],
-back({"actions": [{"type": "log"; "text": player + " 丢弃了 " + item}]}),
/* 主循环：一行请求一行响应 */
while '1'-
-line = #readline(),
-if line == ""-
--break,
--,
-req = #json_decode(line),
-id = req["id"],
-ev = req["event"],
-payload = req["payload"],
-result = {},
-try-
--result = #call("_on_" + ev; payload),
-catch e-
--result = {"error": e},
--,
-print(#json_encode({"id": id; "result": result})),
-,
