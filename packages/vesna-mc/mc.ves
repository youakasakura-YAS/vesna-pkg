/* vesna-mc：三平台桥接模组生成器（Fabric / Forge / NeoForge，MC 1.20.1+）
 *
 * 生成一个可直接用 Gradle 构建的桥接模组项目：
 *   - Java 侧：VesnaBridge（进程桥 + JSON 协议）+ 平台入口 VesnaMod
 *   - 脚本侧：config/vesna/{events.json, runtime.properties, scripts/*.ves}
 *   - 事件：server_started / player_join 已接线；命令：/modid <script> / /modid-reload
 */

def mc_tmpl_dir()-
-back(#getenv("VESNA_HOME") + "\\packages\\vesna-mc\\templates\\"),
,

/* 读模板、注入占位符、写目标文件 */
def mc_write_tpl(name; dst; pkg; modid)-
-t = #fread(mc_tmpl_dir() + name),
-t = #replace(t; "@@PKG@@"; pkg),
-t = #replace(t; "@@MODID@@"; modid),
-t = #replace(t; "@@MAIN@@"; "VesnaMod"),
-#fwrite(dst; t),
-back(true),
,

/* 按点拆包路径建嵌套目录，返回 java 包根路径 */
def mc_mkdirs_pkg(root; pkg)-
-parts = #split(pkg; "."),
-cur = root,
-for pt in parts-
--cur = cur + "\\" + pt,
--#mkdirs(cur),
-,
-back(cur),
,

/* 复制配置与示例脚本到项目 config/vesna */
def mc_copy_config(dir)-
-tmpl = mc_tmpl_dir(),
-#mkdirs(dir + "\\config\\vesna\\scripts"),
-for f in ["events.json"; "runtime.properties"]-
--#fwrite(dir + "\\config\\vesna\\" + f; #fread(tmpl + f)),
-,
-for f in ["server_started.ves"; "server_stopped.ves"; "player_join.ves"; "player_leave.ves"; "player_death.ves"; "player_kill.ves"; "block_break.ves"; "block_place.ves"; "player_chat.ves"; "player_advancement.ves"; "server_tick.ves"; "timer_example.ves"; "hello.ves"]-
--#fwrite(dir + "\\config\\vesna\\scripts\\" + f; #fread(tmpl + f)),
-,
-back(true),
,

/* 事件脚本 -> 常驻函数：去掉 argv/payload 解析，print(#json_encode(X)) 改 return X */
def mc_to_func(name; script)-
-r = "def " + name + "(payload)-",
-for line in #lines(script)-
--t = #trim(line),
--if t == ""-
---continue,
--,
--if #startswith(t; "args = #args(),") or #startswith(t; "payload = #json_decode(args")-
---continue,
--,
--nl = "-" + line,
--if #contains(t; "print(#json_encode(") and #endswith(t; ")),")-
---nl = #replace(nl; "print(#json_encode("; "back("),
---nl = #replace(nl; ")),"; "),"),
--,
--r = r + "\n" + nl,
-,
-back(r),
,

/* 生成常驻脚本 resident.ves（events.json 置 "resident": true 时模组以子进程启动它） */
def mc_make_resident(dir)-
-tmpl = mc_tmpl_dir(),
-rd = "/* Vesna 常驻桥 —— 由模组以子进程方式启动（events.json 的 \"resident\": true）\n",
-rd = rd + "   协议：stdin 每行一个 JSON 请求 {\"id\": N; \"event\": \"...\"; \"payload\": {...}}\n",
-rd = rd + "         stdout 每行一个 JSON 响应 {\"id\": N; \"result\": {...}}\n",
-rd = rd + "   事件函数 _on_<event>(payload) 返回结果 dict/actions，主循环负责分发 */\n",
-events = ["server_started"; "server_stopped"; "player_join"; "player_leave"; "player_death"; "player_kill"; "block_break"; "block_place"; "player_chat"; "player_advancement"; "server_tick"; "timer_example"],
-for ev in events-
--rd = rd + "\n" + mc_to_func("_on_" + ev; #fread(tmpl + ev + ".ves")),
-,
-rd = rd + "\n/* 主循环：一行请求一行响应 */\n",
-rd = rd + "while '1'-\n",
-rd = rd + "-line = #readline(),\n",
-rd = rd + "-if line == \"\"-\n",
-rd = rd + "--break,\n",
-rd = rd + "--,\n",
-rd = rd + "-req = #json_decode(line),\n",
-rd = rd + "-id = req[\"id\"],\n",
-rd = rd + "-ev = req[\"event\"],\n",
-rd = rd + "-payload = req[\"payload\"],\n",
-rd = rd + "-result = {},\n",
-rd = rd + "-try-\n",
-rd = rd + "--result = #call(\"_on_\" + ev; payload),\n",
-rd = rd + "-catch e-\n",
-rd = rd + "--result = {\"error\": e},\n",
-rd = rd + "--,\n",
-rd = rd + "-print(#json_encode({\"id\": id; \"result\": result})),\n",
-rd = rd + "-,\n",
-#fwrite(dir + "\\config\\vesna\\scripts\\resident.ves"; rd),
-back(true),
,

/* ---------- Fabric ---------- */
def mc_fabric(dir; modid; name; ver; pkg; mcver)-
-jroot = dir + "\\src\\main",
-jp = mc_mkdirs_pkg(jroot + "\\java"; pkg),
-tmpl = mc_tmpl_dir(),
-#mkdirs(jroot + "\\resources"),
-mc_write_tpl("VesnaJson.java"; jp + "\\VesnaJson.java"; pkg; modid),
-mc_write_tpl("VesnaBridge.java"; jp + "\\VesnaBridge.java"; pkg; modid),
-mc_write_tpl("MainFabric.java"; jp + "\\VesnaMod.java"; pkg; modid),
-fm = "{\n",
-fm = fm + "  \"schemaVersion\": 1,\n",
-fm = fm + "  \"id\": \"" + modid + "\",\n",
-fm = fm + "  \"version\": \"" + ver + "\",\n",
-fm = fm + "  \"name\": \"" + name + "\",\n",
-fm = fm + "  \"description\": \"Vesna script bridge mod (Fabric)\",\n",
-fm = fm + "  \"authors\": [\"youakasakura-YAS\"],\n",
-fm = fm + "  \"license\": \"MIT\",\n",
-fm = fm + "  \"environment\": \"*\",\n",
-fm = fm + "  \"entrypoints\": {\"main\": [\"" + pkg + ".VesnaMod\"]},\n",
-fm = fm + "  \"depends\": {\"fabricloader\": \">=0.16.0\", \"minecraft\": \"~" + mcver + "\", \"java\": \">=17\"}\n",
-fm = fm + "}\n",
-#fwrite(jroot + "\\resources\\fabric.mod.json"; fm),
-#fwrite(jroot + "\\resources\\pack.mcmeta"; #fread(tmpl + "pack.mcmeta")),
-gb = "plugins {\n",
-gb = gb + "    id 'fabric-loom' version '1.6-SNAPSHOT'\n",
-gb = gb + "    id 'java'\n",
-gb = gb + "}\n",
-gb = gb + "version = \"" + ver + "\"\n",
-gb = gb + "group = \"" + pkg + "\"\n",
-gb = gb + "base { archivesName = \"" + modid + "\" }\n",
-gb = gb + "repositories { mavenCentral() }\n",
-gb = gb + "dependencies {\n",
-gb = gb + "    minecraft \"com.mojang:minecraft:" + mcver + "\"\n",
-gb = gb + "    mappings \"net.fabricmc:yarn:" + mcver + "+build.10:v2\"\n",
-gb = gb + "    modImplementation \"net.fabricmc:fabric-loader:0.16.5\"\n",
-gb = gb + "    modImplementation \"net.fabricmc.fabric-api:fabric-api:0.92.2+" + mcver + "\"\n",
-gb = gb + "}\n",
-gb = gb + "java { sourceCompatibility = JavaVersion.VERSION_17; targetCompatibility = JavaVersion.VERSION_17 }\n",
-#fwrite(dir + "\\build.gradle"; gb),
-#fwrite(dir + "\\settings.gradle"; "rootProject.name = \"" + modid + "\"\n"),
-#fwrite(dir + "\\gradle.properties"; "org.gradle.jvmargs=-Xmx2G\norg.gradle.daemon=true\n"),
-back(true),
,

/* ---------- Forge ---------- */
def mc_forge(dir; modid; name; ver; pkg; mcver)-
-jroot = dir + "\\src\\main",
-jp = mc_mkdirs_pkg(jroot + "\\java"; pkg),
-tmpl = mc_tmpl_dir(),
-#mkdirs(jroot + "\\resources\\META-INF"),
-mc_write_tpl("VesnaJson.java"; jp + "\\VesnaJson.java"; pkg; modid),
-mc_write_tpl("VesnaBridge.java"; jp + "\\VesnaBridge.java"; pkg; modid),
-mc_write_tpl("MainForge.java"; jp + "\\VesnaMod.java"; pkg; modid),
-mt = "modLoader=\"javafml\"\n",
-mt = mt + "loaderVersion=\"[47,)\"\n",
-mt = mt + "license=\"MIT\"\n\n",
-mt = mt + "[[mods]]\n",
-mt = mt + "modId=\"" + modid + "\"\n",
-mt = mt + "version=\"" + ver + "\"\n",
-mt = mt + "displayName=\"" + name + "\"\n",
-mt = mt + "description=\"Vesna script bridge mod (Forge)\"\n",
-mt = mt + "authors=\"youakasakura-YAS\"\n\n",
-mt = mt + "[[dependencies." + modid + "]]\n",
-mt = mt + "modId=\"forge\"\n",
-mt = mt + "mandatory=true\n",
-mt = mt + "versionRange=\"[47,)\"\n",
-mt = mt + "ordering=\"NONE\"\n",
-mt = mt + "side=\"BOTH\"\n",
-#fwrite(jroot + "\\resources\\META-INF\\mods.toml"; mt),
-#fwrite(jroot + "\\resources\\pack.mcmeta"; #fread(tmpl + "pack.mcmeta")),
-gb = "plugins {\n",
-gb = gb + "    id 'java'\n",
-gb = gb + "    id 'net.minecraftforge.gradle' version '[6.0,6.2)'\n",
-gb = gb + "}\n",
-gb = gb + "version = \"" + ver + "\"\n",
-gb = gb + "group = \"" + pkg + "\"\n",
-gb = gb + "base { archivesName = \"" + modid + "\" }\n",
-gb = gb + "java { toolchain.languageVersion = JavaLanguageVersion.of(17) }\n",
-gb = gb + "minecraft {\n",
-gb = gb + "    mappings channel: 'official', version: '" + mcver + "'\n",
-gb = gb + "}\n",
-gb = gb + "dependencies {\n",
-gb = gb + "    minecraft 'net.minecraftforge:forge:" + mcver + "-47.2.0'\n",
-gb = gb + "}\n",
-#fwrite(dir + "\\build.gradle"; gb),
-#fwrite(dir + "\\settings.gradle"; "rootProject.name = \"" + modid + "\"\n"),
-#fwrite(dir + "\\gradle.properties"; "org.gradle.jvmargs=-Xmx2G\norg.gradle.daemon=true\n"),
-back(true),
,

/* ---------- NeoForge ---------- */
def mc_neoforge(dir; modid; name; ver; pkg; mcver)-
-jroot = dir + "\\src\\main",
-jp = mc_mkdirs_pkg(jroot + "\\java"; pkg),
-tmpl = mc_tmpl_dir(),
-#mkdirs(jroot + "\\resources\\META-INF"),
-mc_write_tpl("VesnaJson.java"; jp + "\\VesnaJson.java"; pkg; modid),
-mc_write_tpl("VesnaBridge.java"; jp + "\\VesnaBridge.java"; pkg; modid),
-mc_write_tpl("MainNeoForge.java"; jp + "\\VesnaMod.java"; pkg; modid),
-mt = "modLoader=\"javafml\"\n",
-mt = mt + "loaderVersion=\"[47,)\"\n",
-mt = mt + "license=\"MIT\"\n\n",
-mt = mt + "[[mods]]\n",
-mt = mt + "modId=\"" + modid + "\"\n",
-mt = mt + "version=\"" + ver + "\"\n",
-mt = mt + "displayName=\"" + name + "\"\n",
-mt = mt + "description=\"Vesna script bridge mod (NeoForge)\"\n",
-mt = mt + "authors=\"youakasakura-YAS\"\n\n",
-mt = mt + "[[dependencies." + modid + "]]\n",
-mt = mt + "modId=\"neoforge\"\n",
-mt = mt + "mandatory=true\n",
-mt = mt + "versionRange=\"[47,)\"\n",
-mt = mt + "ordering=\"NONE\"\n",
-mt = mt + "side=\"BOTH\"\n",
-#fwrite(jroot + "\\resources\\META-INF\\neoforge.mods.toml"; mt),
-#fwrite(jroot + "\\resources\\pack.mcmeta"; #fread(tmpl + "pack.mcmeta")),
-gb = "plugins {\n",
-gb = gb + "    id 'java'\n",
-gb = gb + "    id 'net.neoforged.gradle.userdev' version '7.0.95'\n",
-gb = gb + "}\n",
-gb = gb + "version = \"" + ver + "\"\n",
-gb = gb + "group = \"" + pkg + "\"\n",
-gb = gb + "base { archivesName = \"" + modid + "\" }\n",
-gb = gb + "java { toolchain.languageVersion = JavaLanguageVersion.of(17) }\n",
-gb = gb + "repositories { mavenCentral() }\n",
-gb = gb + "dependencies {\n",
-gb = gb + "    implementation \"net.neoforged:neoforge:" + mcver + "-47.1.106\"\n",
-gb = gb + "}\n",
-gb = gb + "neoForge {\n",
-gb = gb + "    runs {\n",
-gb = gb + "        client {}\n",
-gb = gb + "        server {}\n",
-gb = gb + "    }\n",
-gb = gb + "}\n",
-#fwrite(dir + "\\build.gradle"; gb),
-#fwrite(dir + "\\settings.gradle"; "rootProject.name = \"" + modid + "\"\n"),
-#fwrite(dir + "\\gradle.properties"; "org.gradle.jvmargs=-Xmx2G\norg.gradle.daemon=true\n"),
-back(true),
,

/* ---------- 入口 ---------- */
def mc_bridge(dir; platform; modid; name; pkg; mcver)-
-platform = #trim(platform),
-if platform != "fabric" and platform != "forge" and platform != "neoforge"-
--back({"ok": false; "error": "platform 必须为 fabric / forge / neoforge"}),
-,
-ver = "1.0.0",
-#mkdirs(dir),
	-mc_copy_config(dir),
	-mc_make_resident(dir),
	-if platform == "fabric"-
--mc_fabric(dir; modid; name; ver; pkg; mcver),
-elif platform == "forge"-
--mc_forge(dir; modid; name; ver; pkg; mcver),
-else-
--mc_neoforge(dir; modid; name; ver; pkg; mcver),
-,
-rd = "# " + modid + "（Vesna 桥接模组 · " + platform + "）\n\n",
-rd = rd + "把 Vesna 脚本接入 Minecraft（MC " + mcver + "+）。脚本放 config/vesna/scripts/，事件映射在 config/vesna/events.json。\n\n",
-rd = rd + "## 前置\n- 安装 Vesna（vesna.exe --install），或设置 VESNA_HOME / config/vesna/runtime.properties 的 vesna.path\n\n",
-rd = rd + "## 构建\n- gradlew build（需 JDK 17+；首次会下载依赖）\n- 换 MC 版本：修改 mcver 并调整 build.gradle 中对应版本表（Forge/NeoForge 的 47.x / fabric-api 版本随 MC 变化）\n\n",
-rd = rd + "## 使用\n- 命令：/" + modid + " <script> [args...] 执行脚本；/" + modid + "-reload 重载 events.json\n",
-rd = rd + "- 事件映射：config/vesna/events.json；默认 11 事件 + timers 定时（脚本返回 {\"message\": ...} 广播，{\"actions\": [...]} 执行动作）\n",
-rd = rd + "- 脚本协议（单次模式）：argv[1] = JSON payload；stdout 最后一行 JSON 为返回结果\n\n",
-rd = rd + "## 常驻进程模式\n- events.json 置 \"resident\": true 后，模组启动常驻 vesna 进程（resident.ves），事件经 stdin/stdout JSON 行协议分发，适合 server_tick 等高频事件；\n- 命令 /<modid> <script> 与定时任务仍走单次进程。\n",
-#fwrite(dir + "\\README.md"; rd),
-back({"ok": true; "platform": platform; "mcver": mcver; "dir": dir}),
,
