/* vesna-mc 1.3.0 生成器断言：16 事件 / state / tick_interval / 14 动作 / 5 新脚本 */
import vesna-mc,
r1 = mc_bridge("_t31_fabric"; "fabric"; "vesnamc"; "Vesna MC"; "com.example.vesnamc"; "1.20.1"),
print("fabric: " + #json_encode(r1)),
rv = #fread("_t31_fabric\\config\\vesna\\scripts\\resident.ves"),
parts = #split(rv; "/* 主循环"),
fn_part = parts['1'],

/* 1) 16 事件函数（11 旧 + timer + 5 新） */
evs = ["server_started"; "server_stopped"; "player_join"; "player_leave"; "player_death"; "player_kill"; "block_break"; "block_place"; "player_chat"; "player_advancement"; "server_tick"; "timer_example"; "player_use_block"; "player_use_item"; "player_respawn"; "entity_damage"; "player_drop_item"],
all_ok = true,
for ev in evs-
-if not #contains(rv; "def _on_" + ev + "(payload)")-
--all_ok = false,
-,
-,
if all_ok-
-print("PASS 17 functions"),
else-
-print("FAIL functions"),
-,

/* 2) state 共享变量 */
if #contains(fn_part; "state = {}")-
-print("PASS state"),
else-
-print("FAIL state"),
-,

/* 3) 转换正确性 */
if #contains(fn_part; "back({") and not #contains(fn_part; "print(#json_encode({")-
-print("PASS conversion"),
else-
-print("FAIL conversion"),
-,

/* 4) events.json tick_interval + 5 新事件 + min_interval */
ev = #fread("_t31_fabric\\config\\vesna\\events.json"),
if #contains(ev; "tick_interval") and #contains(ev; "player_use_block") and #contains(ev; "player_drop_item") and #contains(ev; "min_interval")-
-print("PASS events.json"),
else-
-print("FAIL events.json"),
-,

/* 5) 新脚本复制到 scripts */
ok2 = #fexists("_t31_fabric\\config\\vesna\\scripts\\player_use_block.ves") and #fexists("_t31_fabric\\config\\vesna\\scripts\\entity_damage.ves") and #fexists("_t31_fabric\\config\\vesna\\scripts\\player_drop_item.ves"),
if ok2-
-print("PASS new scripts"),
else-
-print("FAIL new scripts"),
-,

/* 6) 桥类 14 动作 + 节流 + tickInterval */
vb = #fread("_t31_fabric\\src\\main\\java\\com\\example\\vesnamc\\VesnaBridge.java"),
if #contains(vb; "title") and #contains(vb; "actionbar") and #contains(vb; "set_block") and #contains(vb; "summon") and #contains(vb; "spawn_particle") and #contains(vb; "scoreboard") and #contains(vb; "throttleOk") and #contains(vb; "tickInterval")-
-print("PASS bridge 1.3"),
else-
-print("FAIL bridge 1.3"),
-,

/* 7) 三平台入口 */
fm = #fread("_t31_fabric\\src\\main\\java\\com\\example\\vesnamc\\VesnaMod.java"),
if #contains(fm; "player_use_block") and #contains(fm; "player_drop_item") and #contains(fm; "tickInterval") and #contains(fm; "spawnParticle")-
-print("PASS fabric entry"),
else-
-print("FAIL fabric entry"),
-,
